{
  "name": "@mrmt/vite",
  "version": "0.6.1",
  "description": "Composable Vite plugins for TypeScript libraries: bundling, types, docs",
  "license": "ISC",
  "author": "MathisTLD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathisTLD/marmotte.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./lib/context": {
      "types": "./dist/lib/context.d.ts",
      "import": "./dist/lib/context.js"
    },
    "./base-config": {
      "types": "./dist/base-config.d.ts",
      "import": "./dist/base-config.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js"
    },
    "./dts": {
      "types": "./dist/dts.d.ts",
      "import": "./dist/dts.js"
    },
    "./package-meta": {
      "types": "./dist/package-meta/index.d.ts",
      "import": "./dist/package-meta/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mrmt/unplugin-typedoc": "workspace:^",
    "rollup-plugin-node-externals": "^8.1.2",
    "unplugin-dts": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mrmt/tsconfig": "workspace:^",
    "@mrmt/utils": "workspace:^",
    "@mrmt/vitest": "workspace:^",
    "vite": "*",
    "vitest": "*"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vitepress": "^2.0.0-alpha.16"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  }
}
