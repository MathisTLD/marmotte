{
  "name": "@mrmt/vitepress-plugin-sidebar",
  "version": "0.6.1",
  "description": "VitePress sidebar generated from the docs directory tree (wraps vitepress-sidebar)",
  "license": "ISC",
  "author": "MathisTLD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathisTLD/marmotte.git",
    "directory": "packages/vitepress-plugin-sidebar"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sidebar.d.ts",
      "import": "./dist/sidebar.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./indent.css": "./dist/indent.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0",
    "qsu": "~1.21.0",
    "vitepress-sidebar": "^1.39.0"
  },
  "devDependencies": {
    "@mrmt/tsconfig": "workspace:^",
    "@mrmt/unplugin-typedoc": "workspace:^",
    "@mrmt/utils": "workspace:^",
    "@mrmt/vitest": "workspace:^",
    "vite": "*",
    "vitepress": "^2.0.0-alpha.16",
    "vitest": "*"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0",
    "vitepress": "^2.0.0-alpha.16"
  }
}
