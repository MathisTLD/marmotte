{
  "name": "marmotte-monorepo",
  "version": "0.6.1",
  "private": true,
  "description": "An extensible development toolkit for TypeScript based projects",
  "homepage": "https://github.com/MathisTLD/marmotte#readme",
  "bugs": {
    "url": "https://github.com/MathisTLD/marmotte/issues"
  },
  "license": "ISC",
  "author": "MathisTLD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathisTLD/marmotte.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp run -r test",
    "check": "vp check",
    "fmt": "vp fmt",
    "prepare": "vp config",
    "version": "changeset version && vp install --lockfile-only",
    "release": "vp run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@mrmt/unplugin-typedoc": "workspace:^",
    "@mrmt/vitepress-plugin-sidebar": "workspace:^",
    "@types/node": "*",
    "typescript": "^5.9.0",
    "vite-plus": "1.3.0",
    "vitepress": "^2.0.0-alpha.16"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
